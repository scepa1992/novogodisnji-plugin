# Environment varijable za sigurnu konfiguraciju
# Kopiraj ovaj fajl kao .env i popuni stvarne vrednosti

# OpenAI API ključ
OPENAI_API_KEY=sk-proj-your_openai_key_here

# WordPress API konfiguracija
WP_URL=https://your-site.com/wp-json/velora/v1/create-docek
WP_API_KEY=your_secure_api_key_here

# GitHub konfiguracija (za privatni repo)
VELORA_GITHUB_TOKEN=ghp_your_github_token_here
VELORA_GITHUB_REPO=your-username/your-repo-name
